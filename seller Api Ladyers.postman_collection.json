          "name": "🔐 Authentication",
          "item": [
            {
              "name": "Vendor Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set(\"vendor_token\", response.data.token);",
                      "    pm.collectionVariables.set(\"vendor_id\", response.data.user.id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"vendor@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/vendor/auth/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "vendor",
                    "auth",
                    "login"
                  ]
                }
              },
              "response": []
            },
